# Optional integrations. The stack boots without these values, but the related
# upload, OAuth and email features require real credentials.
CLOUDINARY_CLOUD_NAME=local-disabled
CLOUDINARY_API_KEY=local-disabled
CLOUDINARY_API_SECRET=local-disabled

GOOGLE_CLIENT_ID=local-disabled
GOOGLE_CLIENT_SECRET=local-disabled

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Replace these local defaults before deploying outside a development machine.
JWT_SECRET=replace-with-a-long-random-secret
NEO4J_PASSWORD=veyru-local
AUTH_COOKIE_SECURE=false
