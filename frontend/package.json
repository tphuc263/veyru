{
  "name": "photo-share-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/types/generated-api.ts",
    "api:check": "openapi-typescript openapi/openapi.json -o src/types/generated-api.ts --check",
    "preview": "vite preview",
    "seed": "node scripts/seed-via-api.cjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.18.0",
    "emoji-picker-react": "^4.18.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-easy-crop": "^5.5.6",
    "react-router-dom": "^7.18.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
